# Keep curated benchmark and test logs.
!results/*.log

# Local cmux session bookkeeping written beneath a literal tilde directory.
/~/.cmuxterm/
/deploy.sh
zig-pkg/

# Local Lavish review artifacts.
/.lavish/

# Local experiments and diagnostic scripts.
/junk/

# Repeatable live-model eval outputs; curated scorecards can be checked in separately.
/evals/results/
/playback

# Local audio authoring workspace.
/docs/sound-audition/

