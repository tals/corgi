#!/bin/sh
# Runs ghostty-host, the windowless Ghostty that tools/ghostty_screenshot.ts
# captures in: $GHOSTTY_HOST, or the pinned build in .tools, downloaded and
# checked against its checksum on first use. With --path it prints the
# binary's path instead. Builds come from github.com/tals/ghostty's corgi
# branch (corgi/build.ts there); bun scripts/pin_ghostty_host.ts VERSION
# points this at a newly published one.
set -eu
. "$(dirname -- "$0")/tools.sh"
version=20261126T060254Z-1f619ad80676
name="ghostty-host-$version-$platform-$arch"
project="$root/.tools/$name/ghostty-host"
url="https://corgi.computer/ghostty-host/$version/$name.tar.gz"
case "$platform-$arch" in
    macos-aarch64) sum=6337c425457497157794f3b26ec79ac2463cb9b5f587242ff633b950dca9045d ;;
    linux-x86_64) sum=5380ccba4ac0c448e0a1d7fc9916cac024d69436a02ca3dbf6fb167efb20d099 ;;
    linux-aarch64) sum=d4de839b001e672c3954be91b665e745de0f4181d745e107f0f393c80d17a168 ;;
    *) sum= ;;
esac

if [ -n "${GHOSTTY_HOST:-}" ]; then
    binary=$GHOSTTY_HOST
elif [ -x "$project" ]; then
    binary=$project
elif main_copy "$name/ghostty-host"; then
    binary=$shared
elif [ -n "$sum" ]; then
    fetch "ghostty-host $version" "$url" "$sum" "$name"
    binary=$project
else
    printf 'No ghostty-host %s build for %s-%s.\n' "$version" "$platform" "$arch" >&2
    printf 'Build one from github.com/tals/ghostty (corgi/build.ts) and set GHOSTTY_HOST to it.\n' >&2
    exit 1
fi
if [ "${1:-}" = --path ]; then
    printf '%s\n' "$binary"
    exit 0
fi
exec "$binary" "$@"
