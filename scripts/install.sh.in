#!/bin/sh
set -eu

# Download the release for this machine; refuse unsupported platforms.
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=macos-aarch64; expected=@MAC_SHA256@ ;;
  Linux-x86_64) target=linux-x86_64; expected=@LINUX_SHA256@ ;;
  *) echo 'Corgi supports macOS arm64 and Linux amd64.' >&2; exit 1 ;;
esac
base=@BASE@
version=@VERSION@
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM

download() {
  curl --disable -fsSL --proto '=https' --proto-redir '=https' \
    --connect-timeout 10 --max-time 300 "$base/releases/$version/$1" -o "$tmp/$2"
}
download "corgi-$target" corgi
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$tmp/corgi" | cut -d ' ' -f 1)
else
  actual=$(shasum -a 256 "$tmp/corgi" | cut -d ' ' -f 1)
fi
[ "$actual" = "$expected" ] || { echo 'Corgi checksum mismatch' >&2; exit 1; }

# Corgi verifies the signed manifest and installs its auto-update launcher.
download manifest.json manifest.json
chmod 700 "$tmp/corgi"
"$tmp/corgi" __install "${CORGI_INSTALL_ROOT:-$HOME/.local/share/corgi}" \
  "${CORGI_INSTALL_BIN:-$HOME/.local/bin/corgi}" "$tmp/manifest.json"

# Offer PATH setup only for the default install location.
[ "${CORGI_INSTALL_BIN:-$HOME/.local/bin/corgi}" = "$HOME/.local/bin/corgi" ] || exit 0
case ":$PATH:" in *":$HOME/.local/bin:"*) exit 0 ;; esac
line='case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac'
login_rc=
shell=${SHELL:-sh}
case "${shell##*/}" in
  zsh) rc="${ZDOTDIR:-$HOME}/.zshrc" ;;
  bash)
    rc="$HOME/.bashrc"
    login_rc="$HOME/.profile"
    for file in "$HOME/.bash_profile" "$HOME/.bash_login"; do
      if [ -f "$file" ]; then login_rc=$file; break; fi
    done ;;
  fish) rc="${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/corgi.fish"
    line='fish_add_path "$HOME/.local/bin"' ;;
  *) echo 'Add ~/.local/bin to your PATH, or run ~/.local/bin/corgi.'; exit 0 ;;
esac
setup=${CORGI_UPDATE_PATH:-ask}
if [ "$setup" = ask ] && ( : </dev/tty ) 2>/dev/null; then
  printf 'Add ~/.local/bin to PATH in %s %s? [Y/n] ' "$rc" "$login_rc" >/dev/tty
  read -r answer </dev/tty || answer=n
  case "$answer" in ''|y|Y|yes) setup=1 ;; esac
fi
if [ "$setup" = 1 ]; then
  for file in "$rc" "$login_rc"; do
    [ -n "$file" ] || continue
    mkdir -p "$(dirname "$file")"
    if ! grep -qxF "$line" "$file" 2>/dev/null; then
      printf '\n# Corgi\n%s\n' "$line" >>"$file"
    fi
  done
  echo 'PATH configured for new shells.'
fi
printf 'To use corgi in this terminal, run:\n  %s\n' "$line"
