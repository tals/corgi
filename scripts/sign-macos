#!/bin/sh
set -eu

if [ "${1:-}" = --identity ]; then
    if [ -n "${CORGI_SIGN_IDENTITY:-}" ]; then
        printf '%s\n' "$CORGI_SIGN_IDENTITY"
        exit 0
    fi
    identities=$(/usr/bin/security find-identity -v -p codesigning)
    for kind in 'Developer ID Application:' 'Apple Development:'; do
        matches=$(printf '%s\n' "$identities" | awk -v kind="$kind" 'index($0, "\"" kind) { print $2 }')
        count=$(printf '%s\n' "$matches" | awk 'NF { n++ } END { print n+0 }')
        if [ "$count" = 1 ]; then
            printf '%s\n' "$matches"
            exit 0
        elif [ "$count" -gt 1 ]; then
            echo "Multiple $kind identities; set CORGI_SIGN_IDENTITY to a certificate SHA-1." >&2
            exit 1
        fi
    done
    echo 'No signing identity found. Install a Developer ID Application or Apple Development certificate with its private key, or use -Dcodesign=false for an ad-hoc build.' >&2
    exit 1
fi

if [ "$#" -ne 4 ] || [ "$1" = - ]; then
    echo 'Usage: sign-macos IDENTITY INPUT OUTPUT TIMESTAMP (true or false; a persistent certificate is required)' >&2
    exit 1
fi
case "$4" in
    true) timestamp=--timestamp ;;
    false) timestamp=--timestamp=none ;;
    *) echo 'TIMESTAMP must be true or false' >&2; exit 1 ;;
esac

# Sign a copy: never mutate the compiler cache or a running executable.
/bin/cp "$2" "$3"
/bin/chmod u+w "$3"
/usr/bin/codesign --force --sign "$1" --identifier dev.corgi.cli --options runtime "$timestamp" "$3"
/usr/bin/codesign --verify --strict "$3"
