#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version=0.17.0
case "$(uname -s)" in
    Darwin) platform=macos ;;
    *) platform=$(uname -s | tr '[:upper:]' '[:lower:]') ;;
esac
case "$(uname -m)" in
    arm64) arch=aarch64 ;;
    *) arch=$(uname -m) ;;
esac
name="zig-$arch-$platform-$version"
project="$root/.tools/$name/zig"
url="https://ziglang.org/download/$version/$name.tar.xz"
case "$arch-$platform" in
    aarch64-macos) sum=b607e9b9234790a008116ae5bdb71c6243b84b9fb42a53a9e70fde41c06c536a ;;
    x86_64-macos) sum=4f9a1c5269aa17ebda5e6d3c2b89d6cbf36f7d2b22a0306e9ab98f25f95529c6 ;;
    aarch64-linux) sum=9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8 ;;
    x86_64-linux) sum=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026 ;;
    *) sum= ;;
esac

# Fetches the pinned release into .tools, checked against its checksum.
download() {
    printf 'Downloading Zig %s into %s/.tools\n' "$version" "$root" >&2
    mkdir -p "$root/.tools"
    work=$(mktemp -d "$root/.tools/.zig-download.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    # curl's meter shows size, speed and time left; logs only need errors.
    if [ -t 2 ]; then progress=; else progress=--silent; fi
    curl -fSL --retry 3 $progress -o "$work/zig.tar.xz" "$url"
    echo "$sum  $work/zig.tar.xz" | shasum -a 256 -c - >/dev/null
    printf 'Extracting Zig %s\n' "$version" >&2
    tar -xJf "$work/zig.tar.xz" -C "$work"
    # Another build may have finished the same download first.
    mv "$work/$name" "$root/.tools/" 2>/dev/null || [ -x "$project" ]
    rm -rf "$work"
    trap - EXIT
}

if [ -n "${ZIG:-}" ]; then
    found=$("$ZIG" version 2>/dev/null || echo 'not runnable')
    if [ "$found" != "$version" ]; then
        printf 'Corgi needs Zig %s, but ZIG=%s is %s.\n' "$version" "$ZIG" "$found" >&2
        printf 'Unset ZIG to use %s, or point it at Zig %s.\n' "$project" "$version" >&2
        exit 1
    fi
    compiler=$ZIG
elif command -v zig >/dev/null 2>&1 && [ "$(zig version)" = "$version" ]; then
    compiler=zig
elif [ -x "$project" ]; then
    compiler=$project
elif [ -n "$sum" ]; then
    download
    compiler=$project
else
    printf 'Corgi needs Zig %s, and has no checksum to download it for %s-%s.\n' "$version" "$arch" "$platform" >&2
    printf 'Unpack %s in %s/.tools, or set ZIG=/absolute/path/to/zig.\n' "$url" "$root" >&2
    exit 1
fi
cd "$root"
if [ "${1:-}" = build ]; then
    shift
    # Later -j flags override this default.
    exec nice -n 10 "$compiler" build -j6 "$@"
fi
exec "$compiler" "$@"
