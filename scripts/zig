#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${ZIG:-}" ]; then
    compiler=$ZIG
elif command -v zig >/dev/null 2>&1 && [ "$(zig version)" = 0.16.0 ]; then
    compiler=zig
else
    case "$(uname -s)" in
        Darwin) platform=macos ;;
        *) platform=$(uname -s | tr '[:upper:]' '[:lower:]') ;;
    esac
    case "$(uname -m)" in
        arm64) arch=aarch64 ;;
        *) arch=$(uname -m) ;;
    esac
    compiler="$root/.tools/zig-$arch-$platform-0.16.0/zig"
    if [ ! -x "$compiler" ]; then
        echo 'Corgi requires Zig 0.16.0 (matching the pinned Ghostty API).' >&2
        printf 'Install it in %s, or set ZIG=/absolute/path/to/zig.\n' "${compiler%/zig}" >&2
        exit 1
    fi
fi
if [ "$("$compiler" version)" != 0.16.0 ]; then
    echo 'Expected Zig 0.16.0; set ZIG to the matching compiler.' >&2
    exit 1
fi
cd "$root"
if [ "${1:-}" = build ]; then
    shift
    # Later -j flags override this default.
    exec nice -n 10 "$compiler" build -j6 "$@"
fi
exec "$compiler" "$@"
