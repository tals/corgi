// The landing page on corgi.computer: an assets-only Worker.
// Release paths bypass it through scriptless routes in bucket_routes.ts.
// Deployed by `bun run landingpage:publish`.
{
  "name": "corgi-site",
  "account_id": "7f5e179b466c0478193c9b4667f05950",
  "compatibility_date": "2026-10-01",
  // / serves index.html and /moonlander serves moonlander.html, neither
  // redirecting.
  "assets": { "directory": "./dist" },
  // Query strings require a wildcard. publish.ts installs scriptless bucket
  // bypasses before deploying this route; do not deploy this config directly.
  "routes": [{ "pattern": "corgi.computer/*", "zone_name": "corgi.computer" }],
  "workers_dev": false,
  "preview_urls": false,
}
