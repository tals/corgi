// The landing page on corgi.computer: an assets-only Worker routed on / and
// /moonlander and their locale-prefixed versions. Visits are free and
// uncounted. Other paths never reach it
// and go straight to the release bucket (install.sh, the update channel).
// Deployed by `bun run landingpage:publish`.
{
  "name": "corgi-site",
  "account_id": "7f5e179b466c0478193c9b4667f05950",
  "compatibility_date": "2026-10-01",
  // / serves index.html and /moonlander serves moonlander.html, neither
  // redirecting.
  "assets": { "directory": "./dist" },
  "routes": [
    { "pattern": "corgi.computer/", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/moonlander", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/en", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/en/*", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/zh", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/zh/*", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ja", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ja/*", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ko", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ko/*", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ru", "zone_name": "corgi.computer" },
    { "pattern": "corgi.computer/ru/*", "zone_name": "corgi.computer" },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
