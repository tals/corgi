#!/usr/bin/env bun
// Stands in for ffmpeg in the voice tests: lists fake devices, fails the way
// a denied, busy or missing microphone does, or streams a PCM fixture.
import { appendFileSync, readFileSync } from "node:fs";

const args = process.argv.slice(2);
if (process.env.CORGI_FAKE_FFMPEG_LOG) appendFileSync(process.env.CORGI_FAKE_FFMPEG_LOG, JSON.stringify(args) + "\n");
if (args.includes("-list_devices")) {
  process.stderr.write(
    [
      "[AVFoundation indev @ 0x1] AVFoundation video devices:",
      "[AVFoundation indev @ 0x1] [0] FaceTime HD Camera",
      "[AVFoundation indev @ 0x1] AVFoundation audio devices:",
      "[AVFoundation indev @ 0x1] [0] Studio Microphone",
      "[AVFoundation indev @ 0x1] [1] MacBook Pro Microphone",
      "[in#0 @ 0x2] Error opening input: Input/output error",
      "Error opening input file .",
      "",
    ].join("\n"),
  );
  process.exit(1);
}
switch (process.env.CORGI_FAKE_FFMPEG_FAIL) {
  case "denied":
    process.stderr.write("[AVFoundation indev @ 0x1] Failed to create AV capture input device: not authorized\n");
    process.exit(1);
  case "busy":
    process.stderr.write("[in#0 @ 0x2] Error opening input: Device or resource busy\n");
    process.exit(1);
  case "missing":
    process.stderr.write("[AVFoundation indev @ 0x1] Could not find audio device with name [x] starting from index 0\n");
    process.exit(1);
}
const pcm = process.env.CORGI_FAKE_PCM ? readFileSync(process.env.CORGI_FAKE_PCM) : Buffer.alloc(0),
  speed = Number(process.env.CORGI_FAKE_PCM_SPEED) || 1,
  chunk = 640;
let at = 0;
const timer = setInterval(() => {
  if (at >= pcm.length) {
    clearInterval(timer);
    if (process.env.CORGI_FAKE_FFMPEG_LOG) appendFileSync(process.env.CORGI_FAKE_FFMPEG_LOG, '"done"\n');
    return;
  }
  process.stdout.write(pcm.subarray(at, at + chunk));
  at += chunk;
}, 20 / speed);
// Idle until killed, like a live capture.
setInterval(() => {}, 1 << 30);
