diff --git a/src/wire_compression.ts b/src/wire_compression.ts
new file mode 100644
index 00000000..520fc683
--- /dev/null
+++ b/src/wire_compression.ts
@@ -0,0 +1,86 @@
+import * as zlib from "node:zlib";
+import * as telemetry from "./telemetry";
+
+const capacity = 4 * 1024 * 1024;
+/** One bounded, live history per direction. A new transport always starts fresh. */
+export class Channel {
+  private encoder = zlib.createZstdCompress({
+    params: { [zlib.constants.ZSTD_c_compressionLevel]: 3, [zlib.constants.ZSTD_c_windowLog]: 20 },
+    flush: zlib.constants.ZSTD_e_flush,
+  });
+  private decoder = zlib.createZstdDecompress({ params: { [zlib.constants.ZSTD_d_windowLogMax]: 20 } });
+  private queue: { data: Buffer; done?: (bytes: number) => void }[] = [];
+  private encoding = false;
+  private stopped = false;
+  private emitted = 0;
+  pending = 0;
+  private incoming = 0;
+  private readers: (() => void)[] = [];
+  constructor(
+    private readonly write: (bytes: Buffer) => void,
+    private readonly read: (bytes: Buffer) => void,
+    private readonly failed: (error: Error) => void,
+  ) {
+    this.encoder.on("data", (bytes: Buffer) => {
+      if (this.stopped) return;
+      this.emitted += bytes.length;
+      this.write(bytes);
+    });
+    this.decoder.on("data", (bytes: Buffer) => {
+      if (!this.stopped) this.read(bytes);
+    });
+    this.encoder.on("error", error => this.fail(error));
+    this.decoder.on("error", error => this.fail(error));
+  }
+  private fail(error: Error): void {
+    if (this.stopped) return;
+    this.close();
+    this.failed(error);
+  }
+  encode(data: Buffer, done?: (bytes: number) => void): void {
+    if (this.stopped) return;
+    if (this.pending + data.length > capacity) return this.fail(Error("MessageTooLarge"));
+    this.pending += data.length;
+    this.queue.push({ data, done });
+    this.next();
+  }
+  private next(): void {
+    if (this.encoding || this.stopped) return;
+    const item = this.queue.shift();
+    if (!item) return;
+    this.encoding = true;
+    const before = this.emitted,
+      started = telemetry.begin();
+    this.encoder.write(item.data, error => {
+      if (error) return this.fail(error);
+      if (this.stopped) return;
+      this.pending -= item.data.length;
+      this.encoding = false;
+      const bytes = this.emitted - before;
+      telemetry.end("wire.compress", started, bytes, { raw_bytes: item.data.length });
+      item.done?.(bytes);
+      this.next();
+    });
+  }
+  decode(data: Buffer): void {
+    if (this.stopped) return;
+    if (this.incoming + data.length > capacity) return this.fail(Error("MessageTooLarge"));
+    this.incoming += data.length;
+    this.decoder.write(data, error => {
+      this.incoming -= data.length;
+      if (!this.incoming) for (const done of this.readers.splice(0)) done();
+      if (error) this.fail(error);
+    });
+  }
+  drainInput(): Promise<void> {
+    return this.incoming && !this.stopped ? new Promise(resolve => this.readers.push(resolve)) : Promise.resolve();
+  }
+  close(): void {
+    this.stopped = true;
+    for (const done of this.readers.splice(0)) done();
+    this.queue = [];
+    this.pending = 0;
+    this.encoder.destroy();
+    this.decoder.destroy();
+  }
+}
diff --git a/src/wire_compression.test.ts b/src/wire_compression.test.ts
new file mode 100644
index 00000000..72c7a8f0
--- /dev/null
+++ b/src/wire_compression.test.ts
@@ -0,0 +1,138 @@
+import { expect, test } from "bun:test";
+import { Channel } from "./wire_compression";
+import { Connection } from "./rpc";
+import { Client } from "./peer";
+import { ReadyLoop, n, ptr, READ } from "./native_bridge";
+import { mkdtempSync, rmSync } from "node:fs";
+
+async function until(check: () => boolean): Promise<void> {
+  const end = performance.now() + 3000;
+  while (!check() && performance.now() < end) await Bun.sleep(1);
+  expect(check()).toBe(true);
+}
+test("live history survives byte fragmentation and flushes each message with exact costs", async () => {
+  const wire: Buffer[] = [],
+    decoded: Buffer[] = [],
+    costs: number[] = [],
+    errors: Error[] = [];
+  const receiver = new Channel(
+    () => {},
+    bytes => decoded.push(bytes),
+    error => errors.push(error),
+  );
+  const sender = new Channel(
+    bytes => {
+      wire.push(bytes);
+      for (const byte of bytes) receiver.decode(Buffer.from([byte]));
+    },
+    () => {},
+    error => errors.push(error),
+  );
+  const data = Buffer.from(Array.from({ length: 500 }, (_, i) => `unique-${i} 界 é ${i * 7919}\n`).join(""));
+  try {
+    sender.encode(data, bytes => costs.push(bytes));
+    await until(() => Buffer.concat(decoded).length === data.length);
+    sender.encode(data, bytes => costs.push(bytes));
+    await until(() => Buffer.concat(decoded).length === data.length * 2 && costs.length === 2);
+    expect(Buffer.concat(decoded)).toEqual(Buffer.concat([data, data]));
+    expect(costs[1]).toBeLessThan(costs[0] / 4);
+    expect(costs.reduce((a, b) => a + b, 0)).toBe(Buffer.concat(wire).length);
+    expect(sender.pending).toBe(0);
+    expect(errors).toEqual([]);
+  } finally {
+    sender.close();
+    receiver.close();
+  }
+});
+test("corrupt streams and oversized encoder queues fail closed", async () => {
+  const errors: Error[] = [];
+  const decoder = new Channel(
+    () => {},
+    () => {},
+    error => errors.push(error),
+  );
+  const encoder = new Channel(
+    () => {},
+    () => {},
+    error => errors.push(error),
+  );
+  try {
+    decoder.decode(Buffer.from("not a zstd stream"));
+    encoder.encode(Buffer.alloc(4 * 1024 * 1024 + 1));
+    await until(() => errors.length === 2);
+    expect(encoder.pending).toBe(0);
+  } finally {
+    encoder.close();
+    decoder.close();
+  }
+});
+test("EOF waits for the last compressed message to be decoded", async () => {
+  const decoded: Buffer[] = [],
+    wire: Buffer[] = [],
+    errors: Error[] = [];
+  const sender = new Channel(
+    bytes => wire.push(bytes),
+    () => {},
+    error => errors.push(error),
+  );
+  const receiver = new Channel(
+    () => {},
+    bytes => decoded.push(bytes),
+    error => errors.push(error),
+  );
+  try {
+    await new Promise<void>(resolve => sender.encode(Buffer.from('{"type":"viewer.reconnect"}\n'), () => resolve()));
+    receiver.decode(Buffer.concat(wire));
+    await receiver.drainInput();
+    expect(Buffer.concat(decoded).toString()).toBe('{"type":"viewer.reconnect"}\n');
+    expect(errors).toEqual([]);
+  } finally {
+    sender.close();
+    receiver.close();
+  }
+});
+for (const supported of [false, true])
+  test(`RPC negotiates compression=${supported} in hello without another round trip`, async () => {
+    const loop = new ReadyLoop(),
+      directory = mkdtempSync("/tmp/corgi-codec-test-"),
+      path = directory + "/s";
+    const listener = n.probe_listen(ptr(Buffer.from(path + "\0")));
+    const peers = new Set<Client>();
+    const seen: string[] = [];
+    const registration = loop.watch(listener, () => {
+      const fd = n.probe_accept(listener);
+      if (fd < 0) return;
+      const peer = new Client(
+        fd,
+        loop,
+        cl => {
+          const value = cl.take();
+          seen.push(value.op);
+          if (value.op === "hello") {
+            expect(value.compression).toBe("zstd");
+            expect(cl.canCompress).toBe(true);
+            cl.queue({ type: "hello", request_id: value.request_id, ...(supported ? { compression: "zstd" } : {}) });
+            if (supported) cl.compress();
+          } else cl.queue({ ok: true, pid: 123, request_id: value.request_id });
+          cl.done();
+        },
+        () => {},
+      );
+      peers.add(peer);
+    });
+    registration.arm(READ);
+    const conn = new Connection(path, { compression: true, timeout_ms: 2000 });
+    try {
+      await conn.call("hello");
+      expect(await conn.call("ping")).toEqual({ ok: true, pid: 123 });
+      expect(await Promise.all([conn.call("ping"), conn.call("ping")])).toHaveLength(2);
+      expect(seen).toEqual(["hello", "ping", "ping", "ping"]);
+    } finally {
+      conn.close();
+      for (const peer of peers) peer.close();
+      registration.close();
+      n.probe_close(listener);
+      loop.close();
+      rmSync(directory, { recursive: true, force: true });
+    }
+  });
