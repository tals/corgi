+  let finish!: () => void;
+  const remote = await peer((message, socket) => {
+    socket.write(`{"request_id":${message.request_id},`);
+    finish = () => socket.write('"ok":true,"pid":7}\n');
+  });
+  try {
+    remote.conn.lastReceived = 0;
+    let completed = false;
+    const reply = remote.conn.call("ping").then(value => {
+      completed = true;
+      return value;
+    });
+    await new Promise<void>(resolve => remote.conn.socket.once("data", () => resolve()));
+    expect(remote.conn.lastReceived).toBeGreaterThan(0);
+    expect(completed).toBe(false);
