+test("a silent established stream gets an early spare but partial frame progress does not", async () => {
+  const endpoint = new Endpoint(recoveryProfile, "/unused", new Probe(), new Host());
+  const clock = spyOn(performance, "now").mockReturnValue(10000);
+  const race = spyOn(endpoint as any, "race").mockResolvedValue(undefined);
+  const connection = { lastReceived: 9000, close() {} };
+  const stream = { fresh: true, age: () => 2000 };
+  Reflect.set(endpoint, "connection", connection);
+  Reflect.set(endpoint, "stream", stream);
+  Reflect.set(endpoint, "link", "saved-link");
+  Reflect.set(endpoint, "task", Promise.resolve(false));
+  endpoint.status = "online";
+  endpoint.ready = endpoint.fresh = true;
+  for (let i = 0; i < 30; i++) endpoint.stats.answer(120, false);
+  try {
+    endpoint.pump(false);
+    expect(race).not.toHaveBeenCalled();
+    clock.mockReturnValue(10500);
+    stream.fresh = false;
+    endpoint.pump(false);
+    expect(race).not.toHaveBeenCalled();
+    stream.fresh = true;
+    endpoint.pump(false);
+    expect(race).toHaveBeenCalledTimes(1);
+    expect(endpoint.status).toBe("online");
+    expect(endpoint.ready).toBe(true);
+    // Do not open another spare on every pump while the path stays silent.
+    Reflect.set(endpoint, "raced_at", 10500);
+    clock.mockReturnValue(12000);
+    endpoint.pump(false);
+    expect(race).toHaveBeenCalledTimes(1);
+  } finally {
+    await endpoint.close();
+    clock.mockRestore();
+    race.mockRestore();
+  }
+});
+
+for (const progress of [false, true]) {
+  test(`an early spare ${progress ? "yields to renewed primary byte progress" : "takes over a silent online primary"}`, async () => {
+    const daemon = await flakyDaemon();
+    const endpoint = daemon.endpoint;
+    const open = spyOn(Remote.prototype, "open").mockImplementation(async function (this: Remote) {
+      Reflect.set(this, "socket", endpoint.local);
+      if (progress) Reflect.get(endpoint, "connection").lastReceived = performance.now();
+    });
+    try {
+      await daemon.connect();
+      Reflect.set(endpoint, "profile", recoveryProfile);
+      endpoint.status = "online";
+      Reflect.get(endpoint, "connection").lastReceived = performance.now() - 5000;
+      const generation = endpoint.generation;
+      await Reflect.get(endpoint, "race").call(endpoint, performance.now());
+      if (progress) {
+        expect(endpoint.generation).toBe(generation);
+        expect(endpoint.status).toBe("online");
+        expect(Reflect.get(endpoint, "dialed")).toBeNull();
+      } else {
+        expect(endpoint.generation).toBeGreaterThan(generation);
+        expect(Reflect.get(endpoint, "dialed")).not.toBeNull();
+        await daemon.connect();
+        expect(daemon.seen.filter(request => request.op === "link.resume")).toHaveLength(1);
+      }
+    } finally {
+      open.mockRestore();
+      await daemon.close();
+    }
+  });
+}
