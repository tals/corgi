diff --git a/src/eval_inspect.ts b/src/eval_inspect.ts
new file mode 100644
index 00000000..bed44a0a
--- /dev/null
+++ b/src/eval_inspect.ts
@@ -0,0 +1,87 @@
+import { appendFileSync } from "node:fs";
+import type { Socket } from "node:net";
+import type { Readable } from "node:stream";
+
+/** Read-only diagnostics before SSH encryption; disabled in measured trials. */
+export class Inspect {
+  private pending = Buffer.alloc(0);
+  private upgraded = false;
+  bytes = 0;
+  header = "";
+  frames = 0;
+  payload = 0;
+  compressed = 0;
+  masked = 0;
+  hello: object | null = null;
+  read(chunk: Buffer): void {
+    this.bytes += chunk.length;
+    this.pending = Buffer.concat([this.pending, chunk]);
+    if (!this.upgraded) {
+      const end = this.pending.indexOf("\r\n\r\n");
+      if (end < 0) return;
+      this.header = this.pending.subarray(0, end + 4).toString();
+      this.pending = this.pending.subarray(end + 4);
+      this.upgraded = true;
+    }
+    while (this.pending.length >= 2) {
+      const bytes = this.pending,
+        short = bytes[1] & 127,
+        masked = Boolean(bytes[1] & 128),
+        extended = short === 126 ? 2 : short === 127 ? 8 : 0,
+        head = 2 + extended + (masked ? 4 : 0);
+      if (bytes.length < head) break;
+      const length = short === 126 ? bytes.readUInt16BE(2) : short === 127 ? Number(bytes.readBigUInt64BE(2)) : short;
+      if (length > 4 * 1024 * 1024) throw Error("OversizedDiagnosticFrame");
+      if (bytes.length < head + length) break;
+      const data = (bytes[0] & 15) === 2;
+      if (data) {
+        this.frames++;
+        this.payload += length;
+        if (bytes[0] & 64) this.compressed++;
+        if (masked) this.masked++;
+        if (!this.hello && !(bytes[0] & 64)) {
+          const payload = Buffer.from(bytes.subarray(head, head + length));
+          if (masked) for (let i = 0; i < payload.length; i++) payload[i] ^= bytes[2 + extended + (i % 4)];
+          try {
+            const message = JSON.parse(payload.toString().split("\n")[0]);
+            if (message.op === "hello" || message.type === "hello")
+              this.hello = {
+                op: message.op,
+                type: message.type,
+                accept_encoding: message.accept_encoding,
+                content_encoding: message.content_encoding,
+              };
+          } catch {}
+        }
+      }
+      this.pending = bytes.subarray(head + length);
+    }
+  }
+  result() {
+    return {
+      bytes: this.bytes,
+      header: this.header,
+      frames: this.frames,
+      payload: this.payload,
+      compressed: this.compressed,
+      masked: this.masked,
+      hello: this.hello,
+      incomplete: this.pending.length,
+    };
+  }
+}
+
+export function inspect(machine: string, upstream: Socket, downstream: Readable): () => void {
+  const file = process.env.CORGI_EVAL_CODEC_PROOF;
+  if (!file) return () => {};
+  const up = new Inspect(),
+    down = new Inspect();
+  upstream.on("data", bytes => up.read(bytes));
+  downstream.on("data", bytes => down.read(bytes));
+  let done = false;
+  return () => {
+    if (done) return;
+    done = true;
+    appendFileSync(file, JSON.stringify({ machine, pid: process.pid, up: up.result(), down: down.result() }) + "\n");
+  };
+}
diff --git a/src/eval_transport.ts b/src/eval_transport.ts
new file mode 100644
index 00000000..fc7f2702
--- /dev/null
+++ b/src/eval_transport.ts
@@ -0,0 +1,306 @@
+import { chmodSync, rmSync } from "node:fs";
+import { createConnection, createServer, type Socket } from "node:net";
+
+const protocol = "corgi-stream-v1";
+const capacity = 4 * 1024 * 1024;
+export interface Options {
+  path: string;
+  target: string;
+  maximum?: number;
+  deflate?: boolean;
+}
+export interface Metrics {
+  connections: number;
+  toTarget: number;
+  toClient: number;
+  targetPeak: number;
+  clientPeak: number;
+  pauses: number;
+  drops: number;
+}
+export interface Adapter {
+  close(): Promise<void>;
+  metrics: Metrics;
+}
+function metrics(): Metrics {
+  return { connections: 0, toTarget: 0, toClient: 0, targetPeak: 0, clientPeak: 0, pauses: 0, drops: 0 };
+}
+function socket(path: string): Socket {
+  return createConnection({ path, allowHalfOpen: true, highWaterMark: 65536 });
+}
+
+/** The control adds the same two Unix-socket hops as the WebSocket adapters. */
+export async function listenRaw(options: Options): Promise<Adapter> {
+  const stats = metrics(),
+    clients = new Set<Socket>();
+  const server = createServer({ allowHalfOpen: true, highWaterMark: 65536 }, left => {
+    const right = socket(options.target);
+    stats.connections++;
+    clients.add(left).add(right);
+    left
+      .on("error", () => right.end())
+      .on("close", () => {
+        clients.delete(left);
+        if (!left.readableEnded) right.end();
+      });
+    right
+      .on("error", () => left.end())
+      .on("close", () => {
+        clients.delete(right);
+        if (!right.readableEnded) left.end();
+      });
+    left.on("data", bytes => {
+      stats.toTarget += bytes.length;
+      stats.targetPeak = Math.max(stats.targetPeak, right.writableLength + bytes.length);
+    });
+    right.on("data", bytes => {
+      stats.toClient += bytes.length;
+      stats.clientPeak = Math.max(stats.clientPeak, left.writableLength + bytes.length);
+    });
+    left.pipe(right).pipe(left);
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(options.path, resolve);
+  });
+  chmodSync(options.path, 0o600);
+  return {
+    metrics: stats,
+    async close() {
+      for (const client of clients) client.destroy();
+      await new Promise<void>(resolve => server.close(() => resolve()));
+    },
+  };
+}
+
+/** Binary WebSocket messages carry the existing byte stream, including its hello and zstd history. */
+export async function listenWebSocket(options: Options): Promise<Adapter> {
+  const stats = metrics(),
+    maximum = options.maximum ?? capacity,
+    clients = new Set<() => void>();
+  interface State {
+    target: Socket;
+    stop: () => void;
+    finish: () => void;
+    ending: boolean;
+  }
+  const server = Bun.serve<State>({
+    unix: options.path,
+    fetch(request, server) {
+      const offered = request.headers
+        .get("sec-websocket-protocol")
+        ?.split(",")
+        .map(value => value.trim());
+      if (!offered?.includes(protocol)) return new Response("Subprotocol required", { status: 400 });
+      if (server.upgrade(request, { headers: { "Sec-WebSocket-Protocol": protocol } })) return;
+      return new Response("Upgrade failed", { status: 400 });
+    },
+    websocket: {
+      perMessageDeflate: options.deflate ? { compress: "dedicated", decompress: "dedicated" } : false,
+      idleTimeout: 0,
+      maxPayloadLength: maximum,
+      backpressureLimit: maximum,
+      closeOnBackpressureLimit: true,
+      open(ws) {
+        stats.connections++;
+        const target = socket(options.target);
+        let stopped = false;
+        const stop = () => {
+          if (stopped) return;
+          stopped = true;
+          clients.delete(stop);
+          target.destroy();
+          ws.terminate();
+        };
+        const finish = () => {
+          ws.data.ending = true;
+          target.pause();
+          // Send Close after accepted application bytes have left Bun's queue.
+          if (!ws.getBufferedAmount()) ws.close(1000);
+        };
+        ws.data = { target, stop, finish, ending: false };
+        clients.add(stop);
+        target.on("data", bytes => {
+          if (stopped || ws.data.ending) return;
+          const queued = ws.getBufferedAmount() + bytes.length;
+          stats.clientPeak = Math.max(stats.clientPeak, queued);
+          if (queued > maximum) {
+            stats.drops++;
+            stop();
+            return;
+          }
+          const sent = ws.send(bytes, options.deflate ?? false);
+          if (!sent) {
+            stats.drops++;
+            stop();
+            return;
+          }
+          stats.toClient += bytes.length;
+          if (sent === -1) {
+            stats.pauses++;
+            target.pause();
+          }
+        });
+        target.on("drain", () => {
+          if (!stopped) ws.resume();
+        });
+        target.on("end", finish).on("error", finish);
+        target.on("close", () => {
+          if (!stopped) finish();
+        });
+      },
+      message(ws, message) {
+        const state = ws.data;
+        if (state.ending) return;
+        if (typeof message === "string") {
+          state.stop();
+          return;
+        }
+        const queued = state.target.writableLength + message.length;
+        stats.targetPeak = Math.max(stats.targetPeak, queued);
+        if (queued > maximum) {
+          stats.drops++;
+          state.stop();
+          return;
+        }
+        stats.toTarget += message.length;
+        if (!state.target.write(message)) {
+          stats.pauses++;
+          ws.pause();
+        }
+      },
+      drain(ws) {
+        if (ws.data.ending) ws.data.finish();
+        else ws.data.target.resume();
+      },
+      close(ws) {
+        ws.data?.stop();
+      },
+      error(_error, ws) {
+        ws.data?.stop();
+      },
+    },
+  });
+  chmodSync(options.path, 0o600);
+  return {
+    metrics: stats,
+    async close() {
+      for (const stop of clients) stop();
+      await server.stop(true);
+      rmSync(options.path, { force: true });
+    },
+  };
+}
+
+/** Expose a byte-stream Unix socket backed by Bun's native WebSocket client. */
+export async function listenWebSocketClient(options: Options): Promise<Adapter> {
+  const stats = metrics(),
+    maximum = options.maximum ?? capacity,
+    clients = new Set<() => void>();
+  const server = createServer({ allowHalfOpen: true, highWaterMark: 65536 }, local => {
+    stats.connections++;
+    local.pause();
+    const ws = new WebSocket(`ws+unix://${options.target}:/rpc`, {
+      protocols: [protocol],
+      perMessageDeflate: options.deflate ?? false,
+    });
+    let stopped = false,
+      ending = false,
+      poll: ReturnType<typeof setTimeout> | undefined;
+    const stop = () => {
+      if (stopped) return;
+      stopped = true;
+      clearTimeout(poll);
+      clients.delete(stop);
+      local.destroy();
+      ws.terminate();
+    };
+    const drain = () => {
+      poll = undefined;
+      if (stopped || ws.readyState !== WebSocket.OPEN) return;
+      if (ws.bufferedAmount) {
+        poll = setTimeout(drain, 1);
+        return;
+      }
+      if (ending) ws.close(1000);
+      else local.resume();
+    };
+    clients.add(stop);
+    local.on("data", bytes => {
+      if (stopped || ending) return;
+      const queued = ws.bufferedAmount + bytes.length;
+      stats.targetPeak = Math.max(stats.targetPeak, queued);
+      if (queued > maximum || ws.readyState !== WebSocket.OPEN) {
+        stats.drops++;
+        stop();
+        return;
+      }
+      ws.send(bytes);
+      stats.toTarget += bytes.length;
+      if (ws.bufferedAmount) {
+        stats.pauses++;
+        local.pause();
+        poll ??= setTimeout(drain, 1);
+      }
+    });
+    local.on("drain", () => {
+      if (!stopped) ws.resume();
+    });
+    local.on("end", () => {
+      ending = true;
+      drain();
+    });
+    local.on("error", stop).on("close", stop);
+    ws.onopen = () => {
+      if (
+        ws.protocol !== protocol ||
+        (options.deflate ? ws.extensions !== "permessage-deflate" : Boolean(ws.extensions))
+      ) {
+        stop();
+        return;
+      }
+      drain();
+    };
+    ws.onmessage = event => {
+      if (stopped) return;
+      if (typeof event.data === "string") {
+        stop();
+        return;
+      }
+      const bytes = Buffer.from(event.data),
+        queued = local.writableLength + bytes.length;
+      stats.clientPeak = Math.max(stats.clientPeak, queued);
+      if (queued > maximum) {
+        stats.drops++;
+        stop();
+        return;
+      }
+      stats.toClient += bytes.length;
+      if (!local.write(bytes)) {
+        stats.pauses++;
+        ws.pause();
+      }
+    };
+    ws.onerror = () => {};
+    ws.onclose = () => {
+      ending = true;
+      clearTimeout(poll);
+      local.pause();
+      // EOF must follow bytes already delivered by the WebSocket callbacks.
+      local.end();
+      local.once("finish", stop);
+    };
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(options.path, resolve);
+  });
+  chmodSync(options.path, 0o600);
+  return {
+    metrics: stats,
+    async close() {
+      for (const stop of clients) stop();
+      await new Promise<void>(resolve => server.close(() => resolve()));
+    },
+  };
+}
